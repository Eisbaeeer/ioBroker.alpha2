{
    "i18n": true,
    "type": "panel",
    "items": {
        "host": {
            "type": "text",
            "label": "IP address of the base station",
            "help": "e.g. 192.168.1.100 (optionally with :port)",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "polltime": {
            "type": "number",
            "min": 2000,
            "max": 3600000,
            "step": 1000,
            "label": "Live values every (ms)",
            "help": "temperatures, set points, pump (cyclic.xml); at least 2000",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 4,
            "lg": 3,
            "xl": 3
        },
        "staticInterval": {
            "type": "number",
            "min": 10,
            "max": 3600,
            "label": "Actuators and settings every (s)",
            "help": "complete data (static.xml), after every change as well",
            "xs": 12,
            "sm": 12,
            "md": 4,
            "lg": 3,
            "xl": 3
        },
        "timeout": {
            "type": "number",
            "min": 1000,
            "max": 30000,
            "step": 500,
            "label": "Timeout per request (ms)",
            "xs": 12,
            "sm": 12,
            "md": 4,
            "lg": 3,
            "xl": 3
        },
        "syncTime": {
            "type": "checkbox",
            "label": "Set the clock of the base station automatically",
            "help": "compares every hour and sets the time of ioBroker if the clock differs by more than 30 s; not used while the base station syncs via NTP itself",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        }
    }
}
