{
    "name": "iobroker.alpha2",
    "version": "2.1.0",
    "description": "Local control of the Möhlenhoff Alpha 2 underfloor heating control through its XML API",
    "author": "Eisbaeeer <Eisbaeeer@gmail.com>",
    "contributors": [
        "Eisbaeeer <Eisbaeeer@gmail.com>",
        "djlex83 <dj-lex@gmx.de>"
    ],
    "homepage": "https://github.com/Eisbaeeer/ioBroker.alpha2",
    "license": "MIT",
    "keywords": [
        "ioBroker",
        "Möhlenhoff",
        "Moehlenhoff",
        "Alpha2",
        "Alpha 2",
        "underfloor heating",
        "Fußbodenheizung",
        "climate"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Eisbaeeer/ioBroker.alpha2.git"
    },
    "bugs": {
        "url": "https://github.com/Eisbaeeer/ioBroker.alpha2/issues"
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@iobroker/adapter-core": "^3.4.3"
    },
    "devDependencies": {
        "@alcalzone/release-script": "^5.2.1",
        "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
        "@alcalzone/release-script-plugin-license": "^5.2.2",
        "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
        "@iobroker/adapter-dev": "^1.5.0",
        "@iobroker/eslint-config": "^2.3.4",
        "@iobroker/testing": "^6.3.2",
        "@types/node": "^22.20.5",
        "typescript": "~6.0.3"
    },
    "overrides": {
        "mocha": {
            "glob": "^14.0.2",
            "minimatch": "^11.0.1"
        },
        "rimraf": "^6.1.4"
    },
    "main": "main.js",
    "files": [
        "admin/",
        "lib/",
        "main.js",
        "io-package.json",
        "LICENSE"
    ],
    "scripts": {
        "test": "npm run test:unit && npm run test:package",
        "test:unit": "mocha",
        "test:package": "mocha test/package.js --exit",
        "test:integration": "mocha test/integration.js --exit",
        "check": "tsc --noEmit",
        "lint": "eslint -c eslint.config.mjs .",
        "translate": "translate-adapter",
        "release": "release-script",
        "release-patch": "release-script patch --yes",
        "release-minor": "release-script minor --yes",
        "release-major": "release-script major --yes"
    }
}
